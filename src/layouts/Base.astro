---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import site from '../data/site.json';
import { withBase } from '../utils/paths';

interface Props { title?: string; description?: string; evento?: boolean; noindex?: boolean; }
const path = Astro.url.pathname;
const { title, description = site.description, evento = path === withBase('/') || path === withBase('/programa/'), noindex = false } = Astro.props;
// Título: "Página · Congreso de Innovación en Minería"; la portada usa su propio título completo.
const full = !title ? `${site.name} · ${site.kicker}`
  : title.includes(site.name) ? title : `${title} · ${site.name}`;
const url = new URL(path, Astro.site);
const origin = new URL(withBase('/'), Astro.site).href;
const ogImage = new URL(withBase('/og-image.png'), Astro.site).href;
const ogAlt = `${site.kicker}: ${site.name}. ${site.dates}, ${site.city}`;
// Las horas del programa son preliminares: se usa 00:00:00-05:00 (America/Lima) hasta confirmarlas.
const lugar = { '@type': 'Place', name: site.place, address: { '@type': 'PostalAddress', streetAddress: site.venue, addressLocality: 'Arequipa', addressCountry: 'PE' } };
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  '@id': `${origin}#evento`,
  url: origin,
  inLanguage: 'es-PE',
  name: site.name,
  alternateName: site.kicker,
  slogan: site.tagline,
  startDate: `${site.dateStart}T00:00:00-05:00`,
  endDate: `${site.dateEnd}T00:00:00-05:00`,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: lugar,
  organizer: { '@type': 'Organization', name: site.organizerFull, url: origin },
  subEvent: {
    '@type': 'Event',
    name: `${site.retoName}: ${site.retoFullName}`,
    startDate: `${site.dateStart}T00:00:00-05:00`,
    endDate: `${site.dateEnd}T00:00:00-05:00`,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: lugar,
    url: new URL(withBase('/reto/'), Astro.site).href,
    description: site.retoDescription,
  },
  isAccessibleForFree: site.free,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'PEN',
    availability: 'https://schema.org/InStock',
    url: new URL(withBase('/inscripciones/'), Astro.site).href,
  },
  image: [ogImage],
  description: site.description,
};
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url.href} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} · ${site.kicker}`} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {evento && <script type="application/ld+json" set:html={ldJson} />}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1"><slot /></main>
    <Footer />
    <WhatsAppFlotante />
    <script>import '../scripts/motion.js';</script>
  </body>
</html>
