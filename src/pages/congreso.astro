---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Encontraras from '../components/Encontraras.astro';
import CarruselFotos from '../components/CarruselFotos.astro';
import site from '../data/site.json';
import imagenes from '../data/imagenes.json';
import { withBase } from '../utils/paths';
---
<Base title="El congreso" description={`Qué encontrarás en el ${site.name}: ponencias de la industria, mesas de diálogo, la hackatón ${site.retoName} y networking. ${site.dateShort}, UNSA, Arequipa.`}>
  <Banner etiqueta={site.kicker} titulo="El" acento="congreso" bajada={site.name} />

  <section class="seccion" aria-labelledby="t-intro">
    <div class="wrap dos">
      <div data-reveal>
        <h2 id="t-intro" class="titulo-2">Conocimiento técnico y <em>colaboración</em></h2>
        <p class="lectura-p">{site.description}</p>
        <p class="lectura-p">Tendrá lugar el {site.dates} en el {site.place}, Arequipa. El ingreso es gratuito.</p>
        <div class="acciones"><a class="btn" href={withBase('/inscripciones/')}>Inscríbete gratis</a></div>
      </div>
      <CarruselFotos fotos={imagenes.congresoCarrusel} etiqueta="Fotografías de congresos y de la UNSA" retraso={100} />
    </div>
  </section>

  <!-- Certificado de participación (formulario de Google; costo en site.json) -->
  <section id="certificado" class="seccion" aria-labelledby="t-certificado">
    <div class="wrap">
      <article class="cert" data-reveal>
        <div class="cert__txt">
          <p class="cert__k">¡Ya disponible!</p>
          <h2 id="t-certificado" class="cert__t">Obtén tu <em>certificado</em> de participación</h2>
          <p class="cert__p">Solicita tu certificado de participación en el {site.name} completando el formulario.</p>
          <ol class="cert__pasos">
            <li><span aria-hidden="true">1</span>Completa tus datos en el formulario.</li>
            <li><span aria-hidden="true">2</span>Sube la captura de tu pago de {site.certificado.costo}.</li>
          </ol>
          <a class="btn btn--cobre" href={site.certificado.url} target="_blank" rel="noopener">Ir al formulario<span class="sr"> (se abre en una pestaña nueva)</span></a>
        </div>
        <p class="cert__costo"><span>Costo</span><strong>{site.certificado.costo}</strong><span>por certificado</span></p>
      </article>
    </div>
  </section>

  <section id="lugar" class="seccion seccion--fondo" aria-labelledby="t-lugar">
    <div class="wrap">
      <div class="cab-sec" data-reveal>
        <h2 id="t-lugar" class="titulo-2">Dónde <em>será</em></h2>
        <p>Nuevo Auditorio “Aurelio Pastor”, Facultad de Arquitectura y Urbanismo · Área de Ingenierías de la UNSA, Av. Independencia, Arequipa.</p>
      </div>
      <div class="lugar">
        <figure class="lugar__foto" data-reveal>
          <img src={withBase('/img/fotos/auditorio-aurelio-pastor.jpg')} width="1280" height="591" alt="Nuevo Auditorio Aurelio Pastor de la UNSA: escenario con mesa de ponentes, pantalla y butacas azules" loading="lazy" decoding="async" />
          <figcaption>Nuevo Auditorio “Aurelio Pastor”</figcaption>
        </figure>
        <div class="lugar__mapa" data-reveal data-reveal-delay="90">
          <iframe title="Mapa: Facultad de Arquitectura y Urbanismo de la UNSA, Área de Ingenierías" src="https://maps.google.com/maps?q=Facultad%20de%20Arquitectura%20y%20Urbanismo%20UNSA%2C%20Av.%20Independencia%2C%20Arequipa&z=17&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <a class="btn btn--sec" href="https://www.google.com/maps/search/?api=1&query=Facultad%20de%20Arquitectura%20y%20Urbanismo%20UNSA%2C%20Av.%20Independencia%2C%20Arequipa" target="_blank" rel="noopener">Abrir en Google Maps<span class="sr"> (se abre en una pestaña nueva)</span></a>
        </div>
      </div>

      <div class="antes" data-reveal>
        <h3 id="t-antes" class="antes__t">Antes de ir</h3>
        <ul class="antes__lista">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            <span>Registro y acreditación desde las 9:30</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16M9 15l2 2 4-4" /></svg>
            <span>Ingreso libre con <a href={withBase('/inscripciones/')}>inscripción previa</a></span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M7 9h10M7 12h6M10 17l-1 4 3-1.5 3 1.5-1-4" /></svg>
            <span><a href="#certificado">Certificado opcional</a>: {site.certificado.costo}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" /><path d="M9 10h6M9 13h4" /></svg>
            <span>Avisos en el <a href={site.whatsapp} target="_blank" rel="noopener">grupo de WhatsApp<span class="sr"> (se abre en una pestaña nueva)</span></a></span>
          </li>
        </ul>
        <a class="enlace-flecha antes__ics" href={withBase('/congreso-isee-unsa-2026.ics')} download>Agregar al calendario (.ics)</a>
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-encontraras">
    <div class="wrap">
      <div class="cab-sec" data-reveal>
        <h2 id="t-encontraras" class="titulo-2">Lo que <em>encontrarás</em></h2>
        <p>Revisa el <a href={withBase('/programa/')}>programa completo de los tres días</a>.</p>
      </div>
      <Encontraras />
    </div>
  </section>
</Base>

<style>
  /* Certificado: degradado azul noche → guinda, como las piezas de difusión */
  .cert { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--radio-lg); color: #fff;
    background: linear-gradient(150deg, #1a2140 0%, #2a2245 40%, #4a1a2e 75%, var(--acento) 100%); }
  .cert::after { content: ''; position: absolute; right: -6rem; top: -6rem; width: 22rem; height: 22rem; border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, .12); box-shadow: 0 0 0 2.2rem rgba(255, 255, 255, .03), 0 0 0 4.4rem rgba(255, 255, 255, .02); pointer-events: none; }
  .cert__txt { position: relative; z-index: 1; max-width: 40rem; }
  .cert__k { margin: 0 0 .5rem; font: 700 var(--t-xs)/1.2 var(--f-texto); letter-spacing: .18em; text-transform: uppercase; color: var(--cobre-2); }
  .cert__t { margin: 0; font-size: clamp(1.6rem, 3.2vw, 2.4rem); line-height: 1.1; color: #fff; }
  .cert__t em { color: var(--cobre-2); }
  .cert__p { margin: .9rem 0 1rem; color: rgba(255, 255, 255, .82); line-height: 1.55; }
  .cert__pasos { list-style: none; margin: 0 0 1.4rem; padding: 0; display: grid; gap: .6rem; }
  .cert__pasos li { display: flex; align-items: center; gap: .75rem; }
  .cert__pasos span { flex: none; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; border: 1.5px solid var(--cobre-2); color: var(--cobre-2); font-weight: 700; font-size: .9rem; }
  .cert__costo { position: relative; z-index: 1; margin: 0; display: grid; place-items: center; align-content: center; width: 11rem; height: 11rem; border-radius: 50%;
    background: rgba(255, 255, 255, .06); border: 2px solid var(--cobre-2); text-align: center; }
  .cert__costo span { font-size: var(--t-xs); letter-spacing: .14em; text-transform: uppercase; color: rgba(255, 255, 255, .75); }
  .cert__costo strong { font-size: 2.2rem; line-height: 1.1; color: #fff; }
  @media (max-width: 40rem) {
    .cert { grid-template-columns: 1fr; gap: 1.25rem; }
    .cert__costo { order: -1; width: auto; height: auto; justify-self: start; display: flex; align-items: baseline; gap: .5rem; padding: .45rem 1rem; border-radius: 999px; }
    .cert__costo strong { font-size: 1.25rem; }
    .cert .btn { width: 100%; }
  }
  .lugar { display: grid; gap: 1.25rem; margin-top: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); }
  .lugar__foto { margin: 0; border-radius: var(--radio-lg); overflow: hidden; background: var(--tinta); }
  .lugar__foto img { display: block; width: 100%; height: 100%; min-height: 16rem; object-fit: cover; }
  .lugar__foto figcaption { padding: .6rem .9rem; font-size: var(--t-sm); color: #fff; }
  .lugar__mapa { display: grid; gap: .75rem; align-content: start; }
  .lugar__mapa iframe { width: 100%; height: 22rem; border: 0; border-radius: var(--radio-lg); background: var(--linea); }

  /* Antes de ir: lista breve con iconos lineales granate */
  .antes { margin-top: 1.5rem; padding: 1.25rem clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--linea); border-left: 3px solid var(--acento); border-radius: var(--radio); background: var(--fondo); }
  .antes__t { margin: 0 0 .85rem; font: 700 1.1rem/1.2 var(--f-display); color: var(--texto); }
  .antes__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: .65rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); }
  .antes__lista li { display: flex; align-items: flex-start; gap: .6rem; font-size: var(--t-sm); line-height: 1.45; color: var(--texto); min-width: 0; }
  .antes__lista svg { flex: none; width: 1.15rem; height: 1.15rem; margin-top: .1rem; fill: none; stroke: var(--acento); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .antes__lista a { color: var(--acento); text-underline-offset: .15em; }
  .antes__ics { margin-top: .75rem; }
</style>
