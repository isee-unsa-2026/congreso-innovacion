---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Encontraras from '../components/Encontraras.astro';
import CarruselFotos from '../components/CarruselFotos.astro';
import site from '../data/site.json';
import imagenes from '../data/imagenes.json';
import { withBase } from '../utils/paths';
---
<Base title="El congreso" description={`Qué encontrarás en el ${site.name}: ponencias de la industria, mesas de diálogo, la hackatón ${site.retoName} y networking. ${site.dateShort}, UNSA, Arequipa.`}>
  <Banner etiqueta={site.kicker} titulo="El" acento="congreso" bajada={site.name} />

  <section class="seccion" aria-labelledby="t-intro">
    <div class="wrap dos">
      <div data-reveal>
        <h2 id="t-intro" class="titulo-2">Conocimiento técnico y <em>colaboración</em></h2>
        <p class="lectura-p">{site.description}</p>
        <p class="lectura-p">Tendrá lugar el {site.dates} en el {site.place}, Arequipa. El ingreso es gratuito.</p>
        <div class="acciones"><a class="btn" href={withBase('/inscripciones/')}>Inscríbete gratis</a></div>
      </div>
      <CarruselFotos fotos={imagenes.congresoCarrusel} etiqueta="Fotografías de congresos y de la UNSA" retraso={100} />
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-encontraras">
    <div class="wrap">
      <div class="cab-sec" data-reveal>
        <h2 id="t-encontraras" class="titulo-2">Lo que <em>encontrarás</em></h2>
        <p>El programa detallado se publicará próximamente.</p>
      </div>
      <Encontraras />
    </div>
  </section>
</Base>
