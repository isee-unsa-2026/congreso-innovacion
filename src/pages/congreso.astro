---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Encontraras from '../components/Encontraras.astro';
import site from '../data/site.json';
import imagenes from '../data/imagenes.json';
---
<Base title="El congreso" description={`Qué encontrarás en el ${site.name}: ponencias de la industria, el concurso ${site.retoName} y networking. ${site.dateShort}, UNSA, Arequipa.`}>
  <Banner etiqueta={site.kicker} titulo="El" acento="congreso" bajada={site.name} />

  <section class="seccion" aria-labelledby="t-intro">
    <div class="wrap dos">
      <div data-reveal>
        <h2 id="t-intro" class="titulo-2">Conocimiento técnico y <em>colaboración</em></h2>
        <p class="lectura-p">{site.description}</p>
        <p class="lectura-p">Tendrá lugar el {site.dates} en la {site.venue}. El ingreso es gratuito.</p>
        <div class="acciones"><a class="btn" href="/inscripciones/">Inscríbete gratis</a></div>
      </div>
      <figure class="dos__img" data-reveal data-reveal-delay="100">
        <img src={imagenes.congreso.src} width={imagenes.congreso.width} height={imagenes.congreso.height} alt={imagenes.congreso.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-encontraras">
    <div class="wrap">
      <div class="cab-sec" data-reveal>
        <h2 id="t-encontraras" class="titulo-2">Lo que <em>encontrarás</em></h2>
        <p>El programa detallado se publicará próximamente.</p>
      </div>
      <Encontraras />
    </div>
  </section>
</Base>
