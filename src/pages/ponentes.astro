---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import site from '../data/site.json';
---
<Base title="Ponentes" description={`Ponentes del ${site.name} (${site.kicker}): profesionales de empresas mineras líderes y de la academia. Anuncio próximamente.`}>
  <Banner etiqueta={site.kicker} titulo="" acento="Ponentes" />

  <section class="seccion" aria-labelledby="t-anuncio">
    <div class="wrap anuncio" data-reveal>
      <h2 id="t-anuncio" class="titulo-2">Anuncio <em>próximamente</em></h2>
      <div>
        <p class="anuncio__p">Profesionales de empresas mineras líderes y de la academia compartirán su experiencia en innovación minera.</p>
        <p class="empresas__t">Contaremos con profesionales de</p>
        <ul class="empresas" role="list">
          <li>Cerro Verde</li>
          <li>Anglo American Quellaveco</li>
          <li>Enaex</li>
        </ul>
        <p class="anuncio__p anuncio__p--sec">Las sesiones se concentrarán en el horario más aprovechable del día, sin ocupar la jornada completa, e incluirán coffee break. Iremos anunciando ponentes, horarios y novedades aquí y en el <a href={site.whatsapp} target="_blank" rel="noopener">grupo de WhatsApp</a>.</p>
        <div class="acciones">
          <a class="btn" href="/inscripciones/">Inscríbete gratis</a>
          <a class="btn btn--sec" href="/congreso/">Conocer el congreso</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .anuncio { display: grid; gap: 1rem 4rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); padding-top: 2rem; border-top: 2px solid var(--texto); }
  .anuncio__p { margin: 0; font-size: 1.0625rem; line-height: 1.55; max-width: 56ch; }
  .anuncio .acciones { margin-top: 1.5rem; }
  .anuncio__p--sec { margin-top: 1.25rem; color: var(--texto-2); font-size: 1rem; }
  .empresas__t { margin: 1.5rem 0 .6rem; font: 500 var(--t-xs)/1.2 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--texto-2); }
  .empresas { display: flex; flex-wrap: wrap; gap: .5rem 0; margin: 0; padding: 0; list-style: none; }
  .empresas li { padding: .2rem 1.1rem; font: 600 1rem/1.3 var(--f-texto); color: var(--texto); border-left: 1px solid var(--linea); }
  .empresas li:first-child { padding-left: 0; border-left: 0; }
  @media (max-width: 48rem) { .anuncio { grid-template-columns: 1fr; } }
</style>
