---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import PonentesGrid from '../components/PonentesGrid.astro';
import LogosEmpresas from '../components/LogosEmpresas.astro';
import site from '../data/site.json';
import datos from '../data/ponentes.json';
import { withBase } from '../utils/paths';
const nombres = datos.ponentes.map((p) => [p.titulo, p.nombre].filter(Boolean).join(' ')).join(', ');
---
<Base title="Ponentes" description={`Ponentes confirmados del ${site.name} (${site.kicker}): ${nombres}. ${site.dates}, UNSA, Arequipa.`}>
  <Banner etiqueta={site.kicker} titulo="" acento="Ponentes" />

  <section class="seccion" aria-label="Ponentes confirmados">
    <div class="wrap">
      <PonentesGrid />
    </div>
  </section>

  <section class="seccion seccion--fondo" aria-labelledby="t-empresas">
    <div class="wrap empresas" data-reveal>
      <div>
        <h2 id="t-empresas" class="titulo-2">Profesionales de empresas <em>lÃ­deres</em></h2>
      </div>
      <div class="empresas__logos">
        <LogosEmpresas area={2600} etiqueta="Empresas participantes" />
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-sesiones">
    <div class="wrap sesiones" data-reveal>
      <h2 id="t-sesiones" class="titulo-2">CÃ³mo serÃ¡n las <em>sesiones</em></h2>
      <div>
        <p class="sesiones__p">Las sesiones se concentrarÃ¡n en el horario mÃ¡s aprovechable del dÃ­a, sin ocupar la jornada completa, e incluirÃ¡n coffee break. Iremos anunciando mÃ¡s ponentes y el programa aquÃ­ y en el <a href={site.whatsapp} target="_blank" rel="noopener">grupo de WhatsApp<span class="sr"> (se abre en una pestaÃ±a nueva)</span></a>.</p>
        <div class="acciones">
          <a class="btn" href={withBase('/inscripciones/')}>InscrÃ­bete gratis</a>
          <a class="btn btn--sec" href={withBase('/congreso/')}>Conocer el congreso</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .empresas { display: grid; gap: 1.25rem 4rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); align-items: center; }
  .empresas__p { margin: .5rem 0 0; color: var(--texto-2); max-width: 46ch; }
  .empresas__logos { padding: 1.5rem 1.75rem .9rem; background: var(--blanco); border: 1px solid var(--linea); border-radius: var(--radio-lg); }
  .empresas__logos :global(.logos) { justify-content: space-around; }
  .sesiones { display: grid; gap: 1rem 4rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); padding-top: 1.5rem; border-top: 2px solid var(--texto); }
  .sesiones__p { margin: 0; font-size: 1.0625rem; line-height: 1.55; max-width: 60ch; }
  .sesiones .acciones { margin-top: 1.5rem; }
  @media (max-width: 48rem) {
    .empresas, .sesiones { grid-template-columns: 1fr; }
    .empresas__logos { padding: 1.25rem 1.25rem .75rem; }
    .empresas__logos :global(.logos) { justify-content: flex-start; }
  }
</style>
