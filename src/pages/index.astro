---
import Base from '../layouts/Base.astro';
import Acordeon from '../components/Acordeon.astro';
import Encontraras from '../components/Encontraras.astro';
import RetoBloque from '../components/RetoBloque.astro';
import site from '../data/site.json';
import imagenes from '../data/imagenes.json';
import CarruselFotos from '../components/CarruselFotos.astro';
import { withBase } from '../utils/paths';

const hero = imagenes.hero;
// Carrusel de portada: fotos reales de minería (imagenes.json → "carrusel"); si no hay, queda la foto principal.
const fotos: { src: string; width: number; height: number; alt: string; credito?: string }[] = (imagenes as any).carrusel?.length ? (imagenes as any).carrusel : [hero];
// Enlace que abre Google Calendar con el evento ya cargado (dia completo, 18 y 19 de noviembre).
const calendario = 'https://calendar.google.com/calendar/render?' + new URLSearchParams({
  action: 'TEMPLATE',
  text: `${site.name} · InnoMining ISEE UNSA`,
  dates: `${site.dateStart.replaceAll('-', '')}/20261120`,
  details: `Organiza ${site.organizer}. Ingreso gratuito. Ponencias de la industria minera y la academia, y la hackatón ${site.retoName}. Horarios próximamente.`,
  location: `${site.place}, ${site.city}`,
}).toString().replace('%2F', '/');
const faq = [
  { titulo: '¿Tiene costo participar?', texto: `No. El ingreso al ${site.name} es gratuito.` },
  { titulo: '¿Cuándo y dónde se realiza?', texto: `El ${site.dates}, en el ${site.place}, Arequipa.` },
  { titulo: `¿Qué es ${site.retoName}?`, html: `Es la hackatón del congreso: equipos multidisciplinarios de estudiantes y egresados de la UNSA, con un docente asesor, trabajan sobre retos propuestos por ENAEX, empresa auspiciadora, y presentan una solución propia para afrontarlos. Otorga certificado de la UNSA y su Vicerrectorado de Investigación, y puede ser el inicio de un artículo o una tesis. Bases e inscripción, próximamente por nuestro <a href="${site.whatsapp}" target="_blank" rel="noopener">grupo de WhatsApp</a>.` },
  { titulo: '¿Cómo me inscribo al congreso?', html: `Desde la <a href="${withBase('/inscripciones/')}">página de inscripciones</a>: el registro de asistencia es abierto a todo público y gratuito.` },
];
---
<Base title={`${site.name} · InnoMining ISEE UNSA 2026`} description={`${site.name} (InnoMining · ISEE UNSA): gratuito, ${site.dates} en la UNSA, Arequipa. Ponencias de referentes de la industria minera y la academia, y la hackatón ${site.retoName}.`}>
  <section class="hero" aria-labelledby="titulo-portada">
    <div class="hero__fotos" data-carrusel aria-roledescription="carrusel" aria-label="Fotografías de la industria minera">
      {fotos.map((f, i) => (
        <img class:list={['hero__foto', { 'es-activa': i === 0 }]} src={withBase(f.src)} width={f.width} height={f.height} alt={f.alt} data-credito={f.credito} fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      ))}
    </div>
    {fotos.length > 1 && (
      <div class="hero__ctrl" data-carrusel-ctrl>
        <div class="hero__puntos">
          {fotos.map((_, i) => <button type="button" class:list={['hero__punto', { 'es-activa': i === 0 }]} aria-label={`Ver foto ${i + 1} de ${fotos.length}`} aria-current={i === 0 ? 'true' : undefined} data-ir={i}></button>)}
        </div>
        <p class="hero__credito" data-credito-txt aria-hidden="true">{fotos[0].credito}</p>
      </div>
    )}
    <div class="hero__velo" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <p class="hero__kicker anim" style="--d:0ms">{site.kicker}</p>
      <p class="hero__marco anim" style="--d:80ms">
        <span><time datetime={site.dateStart}>18</time> y <time datetime={site.dateEnd}>19 de noviembre, 2026</time></span>
        <span class="hero__barra" aria-hidden="true">|</span><span class="sr">. </span>
        <span>{site.city}</span>
      </p>
      <h1 id="titulo-portada" class="anim" style="--d:160ms"><span class="hero__num">Primer</span> {site.name.replace(/^Primer /, '')}</h1>
      <p class="hero__org anim" style="--d:240ms">Organiza <strong>{site.organizer}</strong><span aria-hidden="true"> · </span><span class="sr">. Sede: </span>{site.host}</p>
      <p class="hero__lema anim" style="--d:300ms">“{site.tagline}”</p>
      <div class="acciones acciones--centro anim" style="--d:360ms">
        <a class="btn btn--cobre" href={withBase('/inscripciones/')}>Inscríbete gratis</a>
        <a class="btn btn--vidrio" href={withBase('/ponentes/')}>Conoce a los ponentes</a>
      </div>
      <a class="hero__reto anim" style="--d:420ms" href={withBase('/reto/')}>Conoce la hackatón {site.retoName}<span aria-hidden="true"> →</span></a>
    </div>
    <a class="hero__bajar" href="#t-congreso"><span class="sr">Ir al contenido del congreso</span><span class="hero__flecha" aria-hidden="true"></span></a>
  </section>

  <section class="seccion" aria-labelledby="t-congreso">
    <div class="wrap dos">
      <div data-reveal>
        <h2 id="t-congreso" class="titulo-2">Un congreso sobre <em>innovación</em> en minería</h2>
        <p class="lectura-p">Dos días de ponencias técnicas, mesas de diálogo entre la industria y la academia, y la hackatón {site.retoName}, donde equipos de la UNSA proponen soluciones propias a retos de la minería. Para estudiantes, docentes, profesionales y todos quienes trabajan en minería.</p>
        <a class="enlace-flecha" href={withBase('/congreso/')}>Conocer el congreso</a>
      </div>
      <CarruselFotos fotos={imagenes.congresoCarrusel} etiqueta="Fotografías de congresos y de la UNSA" retraso={100} />
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-encontraras">
    <div class="wrap">
      <div class="cab-sec" data-reveal>
        <h2 id="t-encontraras" class="titulo-2">Lo que <em>encontrarás</em></h2>
      </div>
      <Encontraras />
    </div>
  </section>


  <RetoBloque />


  <section class="seccion seccion--fondo" aria-labelledby="t-faq">
    <div class="wrap faq">
      <div class="cab-sec" data-reveal>
        <h2 id="t-faq" class="titulo-2">Preguntas <em>frecuentes</em></h2>
        <a class="faq__cal" href={calendario} target="_blank" rel="noopener">Agregar a Google Calendar<span class="sr"> (se abre en una pestaña nueva)</span></a>
      </div>
      <div data-reveal><Acordeon items={faq} /></div>
    </div>
  </section>

  <section class="cierre" aria-labelledby="t-cierre">
    <div class="wrap cierre__in" data-reveal>
      <div>
        <h2 id="t-cierre" class="cierre__t">Te esperamos en <em>Arequipa</em></h2>
        <p>{site.dates} · {site.place}</p>
      </div>
      <div class="acciones"><a class="btn btn--cobre" href={withBase('/inscripciones/')}>Inscríbete gratis</a></div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero centrado: foto con velo oscuro; protagonista el congreso ---------- */
  .hero { position: relative; isolation: isolate; display: grid; align-items: center; min-height: max(32rem, calc(100svh - 65px)); padding: clamp(2.5rem, 5vw, 3.5rem) 0 4.5rem; background: var(--tinta); overflow: hidden; color: #fff; text-align: center; }
  .hero__fotos { position: absolute; inset: 0; z-index: -2; }
  .hero__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 45%; opacity: 0; transition: opacity 1.4s var(--ease); }
  .hero__foto.es-previa { opacity: 1; z-index: 0; transition: none; }
  .hero__foto.es-activa { opacity: 1; z-index: 1; }
  /* Controles discretos del carrusel: líneas indicadoras y crédito de la foto (abajo a la izquierda) */
  .hero__ctrl { position: absolute; left: clamp(1rem, 4vw, 2.5rem); bottom: 1.25rem; z-index: 1; display: flex; align-items: center; gap: .75rem; }
  .hero__puntos { display: flex; gap: .15rem; }
  .hero__credito { order: 2; margin: 0; font-size: .6875rem; color: rgba(255, 255, 255, .6); max-width: none; }
  .hero__punto { display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 0; background: none; cursor: pointer; }
  .hero__punto::before { content: ""; width: 16px; height: 2px; background: rgba(255, 255, 255, .45); transition: background .3s var(--ease), width .3s var(--ease-out); }
  .hero__punto.es-activa::before { width: 26px; background: var(--cobre); }
  .hero__punto:hover::before { background: #fff; }
  .hero__velo { position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse 70% 60% at 50% 48%, rgba(12, 12, 13, .3) 0%, rgba(12, 12, 13, .5) 100%), linear-gradient(180deg, rgba(12, 12, 13, .4) 0%, rgba(12, 12, 13, .12) 45%, rgba(12, 12, 13, .75) 100%); }
  /* Entrada con acercamiento lento de la foto y flecha para bajar */
  .hero__foto.es-activa { animation: acerca 7s cubic-bezier(.2, .7, .2, 1) both; }
  @keyframes acerca { from { transform: scale(1.08); } to { transform: scale(1); } }
  .hero__bajar { position: absolute; left: 50%; bottom: 1.25rem; display: grid; place-items: center; width: 44px; height: 44px; translate: -50% 0; color: #fff; }
  .hero__flecha { width: 12px; height: 12px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); animation: baja 1.8s ease-in-out infinite; opacity: .85; }
  @keyframes baja { 0%, 100% { translate: 0 -3px; } 50% { translate: 0 4px; } }
  @media (prefers-reduced-motion: reduce) { .hero__foto, .hero__flecha { animation: none; } }
  .hero__in { display: grid; justify-items: center; }
  .hero__kicker { display: inline-flex; align-items: center; gap: .85rem; margin: 0 0 .9rem; font: 500 var(--t-sm)/1.2 var(--f-texto); letter-spacing: .22em; text-transform: uppercase; color: var(--cobre-2); max-width: none; }
  .hero__kicker::before, .hero__kicker::after { content: ""; width: 2.25rem; height: 1px; background: var(--cobre); }
  .hero__num { color: var(--cobre); }
  .hero__marco { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: .25rem .75rem; margin: 0 0 1.25rem; padding: .45rem 1rem; border: 1px solid rgba(255, 255, 255, .55); border-radius: var(--radio); font: 500 .9375rem/1.3 var(--f-texto); letter-spacing: .02em; max-width: none; }
  .hero__barra { color: var(--cobre); }
  .hero h1 { margin: 0; max-width: 22ch; color: #fff; font: 700 clamp(2.1rem, 1.3rem + 2.8vw, 3.6rem)/1.1 var(--f-display); text-shadow: 0 2px 24px rgba(0, 0, 0, .45); }
  .hero__org { margin: .9rem 0 0; color: rgba(255, 255, 255, .9); font-size: 1rem; max-width: 60ch; }
  .hero__org strong { color: #fff; font-weight: 700; }
  .hero__reto { display: inline-block; margin-top: 1.1rem; color: rgba(255, 255, 255, .92); font-size: .9375rem; font-weight: 600; letter-spacing: .02em; text-decoration: underline; text-decoration-color: var(--cobre); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .hero__reto:hover { color: var(--cobre-2); }
  .hero__lema { margin: .35rem 0 0; color: var(--cobre-2); font: 500 italic 1.125rem/1.4 var(--f-display); }
  .hero .acciones { margin-top: 1.5rem; }
  .hero :focus-visible { outline-color: #fff; }

  /* ---------- Ponentes, FAQ y cierre ---------- */
  .faq { display: grid; gap: .75rem 3rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); align-items: start; }
  .faq__cal { display: inline-flex; align-items: center; min-height: 44px; margin-top: .25rem; font-size: var(--t-sm); font-weight: 500; }
  .cierre { background: var(--tinta); color: #fff; padding-block: clamp(2rem, 4vw, 2.75rem); }
  .cierre__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .cierre__t { margin: 0 0 .25rem; color: #fff; font-size: clamp(1.5rem, 1.25rem + 1vw, 1.875rem); font-weight: 700; line-height: 1.15; }
  .cierre__t em { font-style: italic; color: var(--cobre-2); }
  .cierre p { margin: 0; color: rgba(255, 255, 255, .82); }
  .cierre .acciones { margin-top: 0; }
  .cierre :focus-visible { outline-color: #fff; }

  @media (max-width: 48rem) {
    .faq { grid-template-columns: 1fr; }
  }
  @media (max-width: 40rem) {
    .hero { min-height: max(30rem, calc(100svh - 61px)); }
    .hero__foto { object-position: 70% 50%; }
    .hero__bajar { display: none; }
    .hero__ctrl { flex-wrap: wrap; row-gap: .1rem; bottom: .75rem; right: 5rem; }
    .hero__credito { flex-basis: 100%; font-size: .625rem; line-height: 1.35; }
    .hero__kicker { font-size: var(--t-xs); letter-spacing: .18em; }
    .hero__kicker::before, .hero__kicker::after { width: 1.25rem; }
    .hero__marco { font-size: .875rem; }
    .hero .acciones .btn { flex: 1 1 100%; }
    .cierre .acciones, .cierre .acciones .btn { width: 100%; }
  }
  @media (max-width: 16rem) {
    .hero__in { min-width: 0; }
    .hero__kicker { letter-spacing: .1em; }
    .hero__kicker::before, .hero__kicker::after { display: none; }
    .hero__marco { padding-inline: .6rem; }
  }
</style>

<script>
  // Carrusel de portada: fundido entre fotos cada 5 s. Se detiene mientras se usan los controles con
  // teclado y cuando la pestaña no está visible. Con reduced-motion no avanza solo.
  const caja = document.querySelector('[data-carrusel]');
  const ctrl = document.querySelector('[data-carrusel-ctrl]');
  if (caja && ctrl) {
    const fotos = [...caja.querySelectorAll('img')];
    const puntos = [...ctrl.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const credito = ctrl.querySelector('[data-credito-txt]');
    let actual = 0;
    let timer = 0;
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let enfocado = false;
    const precargar = (n: number) => { fotos[n % fotos.length].loading = 'eager'; };
    const ir = (n: number) => {
      fotos.forEach((f) => f.classList.remove('es-previa'));
      fotos[actual].classList.replace('es-activa', 'es-previa');
      puntos[actual].classList.remove('es-activa');
      puntos[actual].removeAttribute('aria-current');
      actual = (n + fotos.length) % fotos.length;
      precargar(actual);
      fotos[actual].classList.add('es-activa');
      puntos[actual].classList.add('es-activa');
      puntos[actual].setAttribute('aria-current', 'true');
      precargar(actual + 1);
      if (credito) credito.textContent = fotos[actual].dataset.credito || '';
    };
    const parar = () => { clearInterval(timer); timer = 0; };
    const seguir = () => {
      parar();
      if (!sinMovimiento && !enfocado && !document.hidden) timer = window.setInterval(() => ir(actual + 1), 5000);
    };
    puntos.forEach((p) => p.addEventListener('click', () => { ir(Number(p.dataset.ir)); seguir(); }));
    ctrl.addEventListener('focusin', () => { enfocado = true; parar(); });
    ctrl.addEventListener('focusout', () => { enfocado = false; seguir(); });
    document.addEventListener('visibilitychange', seguir);
    // En celular: deslizar a los lados cambia de foto (solo gestos claramente horizontales)
    const hero = caja.closest('.hero');
    let x0 = 0, y0 = 0;
    hero?.addEventListener('touchstart', (e) => { const t = (e as TouchEvent).touches[0]; x0 = t.clientX; y0 = t.clientY; }, { passive: true });
    hero?.addEventListener('touchend', (e) => {
      const t = (e as TouchEvent).changedTouches[0];
      const dx = t.clientX - x0, dy = t.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) { ir(actual + (dx < 0 ? 1 : -1)); seguir(); }
    }, { passive: true });
    precargar(1);
    seguir();
  }
</script>
