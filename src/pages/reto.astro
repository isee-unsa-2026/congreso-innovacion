---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Acordeon from '../components/Acordeon.astro';
import site from '../data/site.json';
import reto from '../data/reto.json';
import imagenes from '../data/imagenes.json';

const etapas = reto.etapas.map((e) => ({ titulo: e.nombre, texto: e.texto, pendiente: e.pendiente }));
const img = imagenes.reto;
const secciones = [
  { id: 'resumen', label: 'Resumen' },
  { id: 'reconocimiento', label: 'Reconocimiento' },
  { id: 'desafios', label: 'Desafíos' },
  { id: 'equipos', label: 'Equipos y carreras' },
  { id: 'entregables', label: 'Entregables' },
  { id: 'etapas', label: 'Etapas' },
];
---
<Base title={site.retoName} description={`${site.retoName}, ${site.retoFullName.toLowerCase()}: equipos de 4 estudiantes y egresados UNSA resuelven desafíos reales de empresas del sector.`}>
  <Banner etiqueta={`Concurso del ${site.name}`} bajada={site.retoFullName} imagen="banner"><span class="wordmark"><span class="wordmark__inno">INNO</span>MINING</span></Banner>

  <nav class="subnav" aria-label="Secciones del concurso">
    <div class="wrap">
      <ul>
        {secciones.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <section class="seccion" id="resumen" aria-labelledby="t-resumen">
    <div class="wrap dos">
      <div data-reveal>
        <h2 id="t-resumen" class="titulo-2">Soluciones a <em>problemas reales</em></h2>
        <p class="lectura-p resumen-fuerte">{reto.resumen}</p>
        <h3 class="mini">Qué harán los equipos</h3>
        <ol class="pasos" role="list">
          {reto.pasos.map((p) => <li><strong>{p.titulo}</strong><span>{p.texto}</span></li>)}
        </ol>
        <p class="lectura-p">{reto.importancia}</p>
        <p class="proximo"><strong>Bases</strong><span>Las bases y los desafíos se publicarán próximamente.</span></p>
        <div class="acciones"><a class="btn btn--wa" href={site.whatsapp} target="_blank" rel="noopener">Únete al grupo de WhatsApp<span class="sr"> (se abre en una pestaña nueva)</span></a></div>
        <p class="nota">Postulación: próximamente, con la publicación de las bases. Te avisaremos en el grupo.</p>
      </div>
      <figure class="dos__img" data-reveal data-reveal-delay="100">
        <img src={img.src} width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="reco" id="reconocimiento" aria-labelledby="t-reco">
    <div class="wrap fila">
      <h2 id="t-reco" class="titulo-2 titulo-2--claro" data-reveal>Reconocimiento</h2>
      <div data-reveal>
        <p class="reco__p">{reto.reconocimiento}</p>
        <p class="reco__nota">Otros reconocimientos, el jurado y los criterios de evaluación se publicarán con las bases.</p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--fondo" id="desafios" aria-labelledby="t-desafios">
    <div class="wrap fila">
      <h2 id="t-desafios" class="titulo-2" data-reveal>Desafíos</h2>
      <div data-reveal>
        <p>{reto.desafios.texto}</p>
        <p class="aviso">{reto.desafios.aviso}</p>
      </div>
    </div>
  </section>

  <section class="seccion" id="equipos" aria-labelledby="t-equipos">
    <div class="wrap fila">
      <h2 id="t-equipos" class="titulo-2" data-reveal>Equipos y carreras</h2>
      <div data-reveal>
        <ul class="lista" role="list">
          {reto.requisitos.map((r) => <li>{r}</li>)}
        </ul>
        <h3 class="mini">Carreras recomendadas</h3>
        <ul class="carreras" role="list">
          {reto.carreras.map((c) => <li>{c}</li>)}
        </ul>
        <p class="nota">{reto.carrerasNota}</p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--fondo" id="entregables" aria-labelledby="t-entregables">
    <div class="wrap fila">
      <h2 id="t-entregables" class="titulo-2" data-reveal>Entregables</h2>
      <ol class="entregas" role="list" data-reveal>
        {reto.entregables.map((e) => <li><strong>{e.titulo}</strong><span>{e.texto}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion" id="etapas" aria-labelledby="t-etapas">
    <div class="wrap fila">
      <div data-reveal>
        <h2 id="t-etapas" class="titulo-2">Etapas</h2>
        <p class="nota">Las fechas de cada etapa se publicarán con las bases.</p>
      </div>
      <div data-reveal>
        <Acordeon items={etapas} numerado />
        <p class="nota">Postulación: próximamente, con la publicación de las bases.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .subnav { background: var(--blanco); border-bottom: 1px solid var(--linea); }
  .subnav ul { display: flex; flex-wrap: wrap; justify-content: center; list-style: none; margin: 0; padding: .35rem 0; }
  .subnav li + li { border-left: 1px solid var(--linea); }
  .subnav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; color: var(--texto); text-decoration: none; font: 500 var(--t-xs)/1.2 var(--f-texto); letter-spacing: .12em; text-transform: uppercase; }
  .subnav a { transition: color var(--dur-ui) var(--ease); }
  .subnav a:hover { color: var(--acento); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3em; }
  .seccion[id] { scroll-margin-top: .5rem; }
  .fila { display: grid; gap: .5rem 3rem; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); align-items: start; }
  .fila p:last-child { margin-bottom: 0; }
  .aviso { padding: .7rem .9rem; border-left: 3px solid var(--cobre); background: var(--blanco); font-weight: 500; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .lista li, .carreras li { display: flex; align-items: baseline; gap: .6rem; }
  .lista li::before, .carreras li::before { content: ""; flex: none; width: 5px; height: 5px; background: var(--acento); transform: translateY(-.15em); }
  .mini { margin: 1.1rem 0 .4rem; font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--acento); }
  .carreras { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr)); gap: .3rem 1.5rem; }
  .nota { margin: .6rem 0 0; font-size: var(--t-sm); color: var(--texto-2); }
  .entregas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; border-top: 2px solid var(--texto); counter-reset: e; }
  .entregas li { display: grid; gap: .1rem; padding: .6rem 0 .6rem 2rem; border-bottom: 1px solid var(--linea); position: relative; counter-increment: e; }
  .entregas li::before { content: counter(e, decimal-leading-zero); position: absolute; left: 0; top: .6rem; font: 700 1rem/1.4 var(--f-display); color: var(--acento); }
  .entregas strong { font-weight: 500; }
  .resumen-fuerte { color: var(--texto); font-size: 1.0625rem; }
  .pasos { list-style: none; margin: 0 0 .5rem; padding: 0; border-top: 1px solid var(--linea); counter-reset: p; }
  .pasos li { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); column-gap: .25rem; padding: .5rem 0; border-bottom: 1px solid var(--linea); counter-increment: p; }
  .pasos li::before { content: counter(p); grid-row: span 2; font: 700 1rem/1.5 var(--f-display); color: var(--acento); }
  .pasos strong { font-weight: 600; }
  .pasos span { font-size: var(--t-sm); color: var(--texto-2); }
  .reco { padding-block: clamp(2rem, 4vw, 2.75rem); color: #fff; background: linear-gradient(160deg, var(--acento) 0%, var(--acento-oscuro) 100%); }
  .reco__p { margin: 0; font-size: 1.125rem; line-height: 1.55; color: #fff; max-width: 60ch; }
  .reco__nota { margin: .75rem 0 0; font-size: var(--t-sm); color: rgba(255, 255, 255, .82); }
  .reco :focus-visible { outline-color: #fff; }
  .entregas span { font-size: var(--t-sm); color: var(--texto-2); }
  @media (max-width: 48rem) {
    .fila { grid-template-columns: minmax(0, 1fr); }
    .entregas { grid-template-columns: 1fr; }
    .subnav ul { justify-content: flex-start; }
    .subnav a { padding: 0 .7rem; }
  }
</style>
