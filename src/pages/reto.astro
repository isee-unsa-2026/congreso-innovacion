---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import site from '../data/site.json';
import reto from '../data/reto.json';
import imagenes from '../data/imagenes.json';
import { withBase } from '../utils/paths';

const img = imagenes.reto;
const wa = { href: site.whatsapp, target: '_blank', rel: 'noopener' };
---
<Base title={site.retoName} description={`${site.retoName}, la hackatón del ${site.name}: equipos multidisciplinarios de la UNSA crean soluciones innovadoras a problemas reales de la minería.`}>
  <Banner etiqueta={`Hackatón del ${site.name}`} bajada={site.retoFullName} imagen="banner"><span class="wordmark"><span class="wordmark__inno">INNO</span>MINING</span></Banner>

  <section class="seccion" id="resumen" aria-labelledby="t-resumen">
    <div class="wrap dos">
      <div data-reveal>
        <h2 id="t-resumen" class="titulo-2">Ideas que <em>resuelven</em></h2>
        <p class="lectura-p resumen-fuerte">{reto.resumen}</p>
        <h3 class="mini">Cómo funciona</h3>
        <ol class="pasos" role="list">
          {reto.pasos.map((p) => <li><strong>{p.titulo}</strong><span>{p.texto}</span></li>)}
        </ol>
      </div>
      <figure class="dos__img" data-reveal data-reveal-delay="100">
        <img src={withBase(img.src)} width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
    <div class="wrap">
      <dl class="datos" data-reveal>
        {reto.datosClave.map((d) => <div><dt>{d.dato}</dt><dd>{d.valor}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="reco" aria-labelledby="t-reco">
    <div class="wrap fila">
      <h2 id="t-reco" class="titulo-2 titulo-2--claro" data-reveal>Reconocimiento</h2>
      <p class="reco__texto" data-reveal>{reto.reconocimientoCorto}</p>
    </div>
  </section>

  <section class="seccion seccion--fondo" id="proximamente" aria-labelledby="t-pronto">
    <div class="wrap fila">
      <h2 id="t-pronto" class="titulo-2" data-reveal>Próximamente</h2>
      <div data-reveal>
        <p class="aviso">{reto.proximamente}</p>
        <div class="acciones">
          <a class="btn" {...wa}>Únete al grupo de WhatsApp<span class="sr"> (se abre en una pestaña nueva)</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .fila { display: grid; gap: .5rem 3rem; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); align-items: start; }
  .fila p:last-child { margin-bottom: 0; }
  .aviso { margin: 0; padding: .7rem .9rem; border-left: 3px solid var(--cobre); background: var(--blanco); font-weight: 500; }
  .mini { margin: 1.75rem 0 .5rem; font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--acento); }
  .resumen-fuerte { color: var(--texto); font-size: 1.0625rem; }
  .pasos { list-style: none; margin: 0 0 .5rem; padding: 0; border-top: 1px solid var(--linea); counter-reset: p; }
  .pasos li { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); column-gap: .25rem; padding: .5rem 0; border-bottom: 1px solid var(--linea); counter-increment: p; }
  .pasos li::before { content: counter(p); grid-row: span 2; font: 700 1rem/1.5 var(--f-display); color: var(--acento); }
  .pasos strong { font-weight: 600; }
  .pasos span { font-size: var(--t-sm); color: var(--texto-2); }
  .datos { margin: clamp(1.75rem, 3vw, 2.5rem) 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); border-top: 2px solid var(--texto); }
  .datos div { padding: .7rem 1rem .8rem 0; border-bottom: 1px solid var(--linea); }
  .datos dt { font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--acento); }
  .datos dd { margin: .2rem 0 0; font-size: var(--t-sm); color: var(--texto); }
  .reco { padding-block: clamp(2rem, 4vw, 2.75rem); color: #fff; background: linear-gradient(160deg, var(--acento) 0%, var(--acento-oscuro) 100%); }
  .reco__texto { margin: 0; font-size: 1.0625rem; line-height: 1.55; color: #fff; max-width: 62ch; }
  @media (max-width: 48rem) {
    .fila { grid-template-columns: minmax(0, 1fr); }
  }
</style>
