---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import site from '../data/site.json';
import reto from '../data/reto.json';
import imagenes from '../data/imagenes.json';
import { withBase } from '../utils/paths';

const img = imagenes.reto;
---
<Base title={site.retoName} description={`${site.retoName}, concurso del ${site.name}: retos planteados por ENAEX para equipos multidisciplinarios de la UNSA. Bases e inscripción, próximamente.`}>
  <Banner etiqueta={`Concurso del ${site.name}`} bajada={site.retoFullName} imagen="banner"><span class="wordmark"><span class="wordmark__inno">INNO</span>MINING</span></Banner>

  <section class="seccion" aria-labelledby="t-que">
    <div class="wrap dos">
      <div data-reveal>
        <h2 id="t-que" class="titulo-2">Qué es <em>{site.retoName}</em></h2>
        <p class="lectura-p resumen-fuerte">{reto.resumen}</p>
        <h3 class="mini">Retos de ENAEX</h3>
        <p class="aviso">{reto.retosEnaex}</p>
        <h3 class="mini">Quiénes pueden participar</h3>
        <p class="lectura-p">{reto.participan}</p>
      </div>
      <figure class="dos__img" data-reveal data-reveal-delay="100">
        <img src={withBase(img.src)} width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="seccion seccion--fondo" aria-labelledby="t-claves">
    <div class="wrap fila">
      <h2 id="t-claves" class="titulo-2" data-reveal>Cosas clave</h2>
      <ul class="lista" role="list" data-reveal>
        {reto.claves.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-sust">
    <div class="wrap fila">
      <h2 id="t-sust" class="titulo-2" data-reveal>La sustentación</h2>
      <div data-reveal>
        <p>Cada equipo presentará su propuesta respondiendo, en general, a estas preguntas:</p>
        <ol class="preguntas">
          {reto.preguntas.map((q) => <li>{q}</li>)}
        </ol>
        <h3 class="mini">Seguridad</h3>
        <p>{reto.seguridad}</p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--fondo" aria-labelledby="t-pronto">
    <div class="wrap fila">
      <h2 id="t-pronto" class="titulo-2" data-reveal>Próximamente</h2>
      <div data-reveal>
        <p>{reto.proximamente}</p>
        <div class="acciones">
          <a class="btn" href={site.whatsapp} target="_blank" rel="noopener">Únete al grupo de WhatsApp<span class="sr"> (se abre en una pestaña nueva)</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .fila { display: grid; gap: .5rem 3rem; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); align-items: start; }
  .fila p:last-child { margin-bottom: 0; }
  .aviso { padding: .7rem .9rem; border-left: 3px solid var(--cobre); background: var(--fondo); font-weight: 500; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .lista li { display: flex; align-items: baseline; gap: .6rem; }
  .lista li::before { content: ""; flex: none; width: 5px; height: 5px; background: var(--acento); transform: translateY(-.15em); }
  .mini { margin: 1.5rem 0 .5rem; font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--acento); }
  .preguntas { margin: .25rem 0 0; padding-left: 1.4rem; display: grid; gap: .2rem; }
  .preguntas li::marker { color: var(--acento); font-weight: 700; }
  .resumen-fuerte { color: var(--texto); font-size: 1.0625rem; }
  @media (max-width: 48rem) {
    .fila { grid-template-columns: minmax(0, 1fr); }
  }
</style>
