---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import OrganizadoresPerfil from '../components/OrganizadoresPerfil.astro';
import site from '../data/site.json';
import { withBase } from '../utils/paths';
const hayUnsa = fs.existsSync(path.join(process.cwd(), 'public', 'brand', 'unsa-logo.png'));
---
<Base title="Organizadores" description={`Comité organizador del ${site.name}: ${site.organizerFull} como organizador y la ${site.host} como sede anfitriona.`}>
  <Banner etiqueta={site.kicker} titulo="" acento="Organizadores" />

  <section class="seccion" aria-label="Comité organizador">
    <div class="wrap">
      <OrganizadoresPerfil />
    </div>
  </section>

  <section class="seccion seccion--fondo" aria-labelledby="t-instituciones">
    <div class="wrap">
      <h2 id="t-instituciones" class="titulo-2" data-reveal>Instituciones</h2>
      <div class="inst">
        <article data-reveal>
          <img src={withBase('/brand/isee-unsa-logo-512.png')} width="64" height="64" alt="" loading="lazy" decoding="async" />
          <div>
            <h3>Organiza</h3>
            <p class="inst__nombre">{site.organizerFull}</p>
            <p>Capítulo estudiantil de la International Society of Explosives Engineers en la UNSA. Organiza el congreso y la hackatón {site.retoName}.</p>
          </div>
        </article>
        <article data-reveal data-reveal-delay="90">
          {hayUnsa && <img src={withBase('/brand/unsa-logo.png')} width="52" height="64" alt="" loading="lazy" decoding="async" />}
          <div>
            <h3>Sede anfitriona</h3>
            <p class="inst__nombre">{site.host}</p>
            <p>Sede del congreso, en el {site.place}.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .inst { display: grid; gap: 1.25rem 2.5rem; margin-top: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr)); }
  .inst article { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1.1rem; align-items: start; padding-top: 1.1rem; border-top: 2px solid var(--texto); }
  .inst img { width: 4rem; height: 4rem; object-fit: contain; }
  .inst h3 { margin: 0; font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--texto-2); }
  .inst__nombre { margin: .3rem 0 .4rem; font-size: 1.125rem; font-weight: 700; color: var(--texto); }
  .inst p:last-child { margin-bottom: 0; font-size: var(--t-sm); color: var(--texto-2); }
</style>
