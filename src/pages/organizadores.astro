---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import OrganizadoresPerfil from '../components/OrganizadoresPerfil.astro';
import site from '../data/site.json';
import { withBase } from '../utils/paths';
const hayUnsa = fs.existsSync(path.join(process.cwd(), 'public', 'brand', 'unsa-logo.png'));
---
<Base title="Organizadores" description={`Comité organizador del ${site.name}: ${site.organizerFull} como organizador y la ${site.host} como sede anfitriona.`}>
  <Banner etiqueta={site.kicker} titulo="" acento="Organizadores" />

  <section class="seccion seccion--fondo" aria-label="Comité organizador">
    <div class="wrap">
      <OrganizadoresPerfil />
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-instituciones">
    <div class="wrap">
      <h2 id="t-instituciones" class="titulo-2" data-reveal>Instituciones</h2>
      <!-- Mención especial: el congreso nace en la Escuela Profesional de Ingeniería de Minas -->
      <article class="escuela" data-reveal>
        <img src={withBase('/brand/minas-logo.png')} width="496" height="444" alt="Escuela Profesional de Ingeniería de Minas de la UNSA" loading="lazy" decoding="async" />
        <div>
          <p class="escuela__k">Desde la Escuela</p>
          <p class="escuela__n">Escuela Profesional de Ingeniería de Minas · UNSA</p>
          <p class="escuela__t">El {site.name} nace en nuestra Escuela: estudiantes, egresados y docentes de Ingeniería de Minas lo impulsan para acercar la innovación de la industria a las aulas de la UNSA.</p>
        </div>
        <div class="escuela__aniv">
          <span class="aniv" aria-hidden="true"><b>31</b><i>Años</i></span>
          <p>Este congreso se realiza en el marco del <strong>31.º aniversario</strong> de la Escuela Profesional de Ingeniería de Minas.</p>
        </div>
      </article>
      <div class="inst">
        <article data-reveal>
          <img src={withBase('/brand/isee-unsa-logo-512.png')} width="64" height="64" alt="" loading="lazy" decoding="async" />
          <div>
            <h3>Organiza</h3>
            <p class="inst__nombre">{site.organizerFull}</p>
            <p>Capítulo estudiantil de la International Society of Explosives Engineers en la UNSA. Organiza el congreso y la hackatón {site.retoName}.</p>
          </div>
        </article>
        <article data-reveal data-reveal-delay="90">
          {hayUnsa && <img class="inst__ancho" src={withBase('/brand/unsa-imagotipo.png')} width="900" height="302" alt="" loading="lazy" decoding="async" />}
          <div>
            <h3>Sede anfitriona</h3>
            <p class="inst__nombre">{site.host}</p>
            <p>Sede del congreso, en el {site.place}.</p>
          </div>
        </article>
        <article data-reveal data-reveal-delay="180">
          <img src={withBase('/brand/fggm-logo.png')} width="466" height="444" alt="" loading="lazy" decoding="async" />
          <div>
            <h3>Facultad</h3>
            <p class="inst__nombre">Facultad de Geología, Geofísica y Minas</p>
            <p>Facultad de la UNSA a la que pertenece la Escuela Profesional de Ingeniería de Minas.</p>
          </div>
        </article>
      </div>
      <!-- Vicerrectorado de Investigación y sus unidades de emprendimiento -->
      <article class="vri" data-reveal>
        <div class="vri__cab">
          <img src={withBase('/img/logos/vri.png')} width="915" height="180" alt="Vicerrectorado de Investigación de la UNSA" loading="lazy" decoding="async" />
          <div>
            <h3>Vicerrectorado</h3>
            <p class="inst__nombre">Vicerrectorado de Investigación · UNSA</p>
            <p class="vri__t">Respalda el congreso y la hackatón {site.retoName}, junto con sus unidades de innovación y emprendimiento.</p>
          </div>
        </div>
        <ul class="vri__u" role="list" aria-label="Unidades del Vicerrectorado de Investigación">
          <li><img src={withBase('/img/logos/die.png')} width="745" height="198" alt="Dirección de Incubadora de Empresas (DIE) de la UNSA" loading="lazy" decoding="async" /></li>
          <li><img src={withBase('/img/logos/jaku.png')} width="552" height="200" alt="JAKU Emprende UNSA" loading="lazy" decoding="async" /></li>
        </ul>
      </article>
    </div>
  </section>
</Base>

<style>
  .escuela { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1.5rem; align-items: center; margin-top: 1.5rem; padding: 1.5rem clamp(1.25rem, 3vw, 2rem); background: var(--fondo); border-left: 4px solid var(--acento); border-radius: var(--radio-lg); }
  .escuela img { width: 6.5rem; height: auto; object-fit: contain; }
  .escuela__k { margin: 0; font: 600 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .16em; text-transform: uppercase; color: var(--acento); }
  .escuela__n { margin: .35rem 0 .5rem; font-size: 1.375rem; font-weight: 700; line-height: 1.2; color: var(--texto); }
  .escuela__t { margin: 0; max-width: 62ch; color: var(--texto-2); line-height: 1.55; }
  /* Aniversario de la Escuela: sello «31 Años» (serif cursiva + caligráfica) con su nota */
  .escuela { grid-template-columns: 6.5rem minmax(0, 1fr) minmax(11rem, 14rem); }
  .escuela__aniv { display: grid; justify-items: center; gap: .6rem; padding-left: 1.5rem; border-left: 1px solid var(--linea); text-align: center; }
  .escuela__aniv p { margin: 0; font-size: var(--t-xs); line-height: 1.45; color: var(--texto-2); }
  .escuela__aniv strong { color: var(--acento); }
  .aniv { display: inline-flex; align-items: flex-start; gap: .1rem; color: var(--acento); line-height: .8; }
  .aniv b { font: italic 900 3.4rem/.8 "Playfair Display", Georgia, serif; letter-spacing: -.04em; }
  .aniv i { font: 400 1.25rem/1 Lobster, cursive; margin-top: .05rem; }
  @media (max-width: 52rem) {
    .escuela { grid-template-columns: 6.5rem minmax(0, 1fr); }
    .escuela__aniv { grid-column: 1 / -1; grid-template-columns: auto minmax(0, 1fr); justify-items: start; align-items: center; gap: 1rem; padding: 1rem 0 0; border-left: 0; border-top: 1px solid var(--linea); text-align: left; }
  }
  @media (max-width: 30rem) { .escuela { grid-template-columns: 1fr; } .escuela img { width: 5rem; } .aniv b { font-size: 2.6rem; } .aniv i { font-size: 1rem; } }
  .inst { display: grid; gap: 1.25rem 2.5rem; margin-top: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr)); }
  .inst article { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1.1rem; align-items: start; padding-top: 1.1rem; border-top: 2px solid var(--texto); }
  .inst img { width: 4rem; height: 4rem; object-fit: contain; }
  /* Imagotipo horizontal de la UNSA: va arriba del texto, a su proporción real */
  .inst article:has(.inst__ancho) { grid-template-columns: 1fr; gap: .8rem; }
  .inst .inst__ancho { width: 11.5rem; height: auto; }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .inst article, .escuela, .vri { transition: transform var(--dur-ui) var(--ease-out), box-shadow var(--dur-ui) var(--ease-out); }
    .inst article:hover { transform: translateY(-3px); }
    .escuela:hover { transform: translateY(-3px); box-shadow: 0 18px 34px -24px rgba(18, 19, 21, .45); }
  }
  .inst h3 { margin: 0; font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--texto-2); }
  .inst__nombre { margin: .3rem 0 .4rem; font-size: 1.125rem; font-weight: 700; color: var(--texto); }
  .vri { margin-top: 1.75rem; padding-top: 1.1rem; border-top: 2px solid var(--texto); display: grid; gap: 1.1rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr)); align-items: center; }
  .vri__cab { display: grid; gap: .8rem; }
  .vri__cab img { width: auto; height: 2.6rem; max-width: 100%; object-fit: contain; object-position: left; }
  .vri h3 { margin: 0; font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--texto-2); }
  .vri__t { margin: 0; font-size: var(--t-sm); color: var(--texto-2); }
  .vri__u { list-style: none; margin: 0; padding: 1rem 1.25rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-around; gap: 1.25rem 2rem; background: var(--fondo); border-radius: var(--radio-lg); }
  .vri__u img { width: auto; height: 3.1rem; max-width: 100%; object-fit: contain; }
  .inst p:last-child { margin-bottom: 0; font-size: var(--t-sm); color: var(--texto-2); }
</style>
