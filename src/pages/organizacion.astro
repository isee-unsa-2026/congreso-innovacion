---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import site from '../data/site.json';
import { withBase } from '../utils/paths';
const hayUnsa = fs.existsSync(path.join(process.cwd(), 'public', 'brand', 'unsa-logo.png'));
---
<Base noindex title="Organización" description={`Quién organiza el ${site.name}: ISEE UNSA Student Chapter como organizador y la UNSA como sede anfitriona.`}>
  <Banner etiqueta={site.kicker} titulo="" acento="Organización" />

  <section class="seccion" aria-label="Organizador e institución anfitriona">
    <div class="wrap">
      <p class="lead lectura" data-reveal>El {site.name} ({site.kicker}) es una iniciativa de {site.organizerFull}, con la {site.host} como sede anfitriona.</p>
      <div class="bloques">
        <article data-reveal data-reveal-delay="0">
          <img src={withBase('/brand/isee-unsa-logo-512.png')} width="72" height="72" alt="" loading="lazy" decoding="async" />
          <h2 class="h3">Organiza</h2>
          <p><strong>{site.organizerFull}</strong></p>
          <p>Capítulo estudiantil de la International Society of Explosives Engineers en la UNSA. Organiza el congreso y el concurso {site.retoName}.</p>
        </article>
        <article data-reveal data-reveal-delay="70">
          {hayUnsa && <img class="unsa" src={withBase('/brand/unsa-logo.png')} width="206" height="256" alt="" loading="lazy" decoding="async" />}
          <h2 class="h3">Sede anfitriona</h2>
          <p><strong>{site.host}</strong></p>
          <p>Sede del congreso. Sus estudiantes y egresados son el público de {site.retoName}.</p>
        </article>
        <article data-reveal data-reveal-delay="140">
          <h2 class="h3">Aliados</h2>
          <p>Solo se mostrarán instituciones y marcas que autoricen formalmente el uso de su nombre o logotipo. Anuncio próximamente.</p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .bloques { display: grid; gap: 2rem; margin-top: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); }
  .bloques article { padding-top: 1.25rem; border-top: 2px solid var(--texto); }
  .bloques img { width: 72px; height: 72px; object-fit: contain; margin-bottom: 1rem; }
  .bloques img.unsa { width: auto; }
  .bloques h2.h3 { font-size: var(--t-h3); font-weight: 700; color: var(--texto); }
  .bloques p:last-child { margin-bottom: 0; }
</style>
