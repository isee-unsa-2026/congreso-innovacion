---
// Botón "Compartir": usa la hoja nativa del sistema (navigator.share) cuando existe; si no, abre un
// menú pequeño con WhatsApp, Copiar enlace y Correo. `claro` adapta el botón a fondos oscuros.
import site from '../data/site.json';
import { withBase } from '../utils/paths';

interface Props { texto?: string; ruta?: string; claro?: boolean; }
const {
  texto = `${site.name} · ${site.dates} · ${site.city} · Ingreso gratuito`,
  ruta = '/',
  claro = false,
} = Astro.props;
const url = new URL(withBase(ruta), Astro.site).href;
const mensaje = `${texto} ${url}`;
const wa = 'https://wa.me/?' + new URLSearchParams({ text: mensaje }).toString();
const correo = `mailto:?subject=${encodeURIComponent(site.name)}&body=${encodeURIComponent(mensaje)}`;
const id = `compartir-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['compartir', { 'compartir--claro': claro }]} data-compartir data-titulo={site.name} data-texto={texto} data-url={url}>
  <button type="button" class="btn btn--sec btn--sin-flecha compartir__btn" aria-expanded="false" aria-controls={`${id}-menu`}>
    <svg class="compartir__ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
      <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" />
    </svg>
    Compartir
  </button>
  <ul class="compartir__menu" id={`${id}-menu`} role="list" hidden>
    <li><a href={wa} target="_blank" rel="noopener">WhatsApp<span class="sr"> (se abre en una pestaña nueva)</span></a></li>
    <li><button type="button" data-copiar>Copiar enlace</button></li>
    <li><a href={correo}>Correo</a></li>
  </ul>
  <p class="compartir__estado" role="status" aria-live="polite" data-estado></p>
</div>
<style>
  .compartir { position: relative; display: inline-flex; flex-direction: column; align-items: flex-start; }
  .compartir__btn { gap: .5rem; }
  .compartir__ico { flex: none; }
  .compartir--claro .compartir__btn { border-color: rgba(255, 255, 255, .7); color: #fff; }
  .compartir--claro .compartir__btn:hover { background: #fff; border-color: #fff; color: var(--tinta); }
  .compartir__menu {
    position: absolute; top: calc(100% + .4rem); left: 0; z-index: 20; min-width: 12rem;
    margin: 0; padding: .35rem; list-style: none;
    background: var(--blanco); border: 1px solid var(--linea); border-radius: var(--radio);
    box-shadow: 0 12px 28px -12px rgba(12, 4, 6, .35);
  }
  .compartir__menu[hidden] { display: none; }
  .compartir__menu a, .compartir__menu button {
    display: flex; align-items: center; width: 100%; min-height: 44px; padding: .5rem .75rem;
    border: 0; border-radius: calc(var(--radio) - 2px); background: none; cursor: pointer;
    font: 500 var(--t-sm)/1.3 var(--f-texto); color: var(--texto); text-align: left; text-decoration: none;
  }
  .compartir__menu a:hover, .compartir__menu button:hover,
  .compartir__menu a:focus-visible, .compartir__menu button:focus-visible { background: var(--fondo); color: var(--acento); }
  .compartir__menu :focus-visible { outline-offset: -2px; }
  .compartir__estado { margin: .35rem 0 0; min-height: 1.2em; font-size: var(--t-xs); line-height: 1.2; color: var(--texto-2); max-width: none; }
  .compartir__estado:empty { min-height: 0; margin: 0; }
  .compartir--claro .compartir__estado { color: rgba(255, 255, 255, .85); }
  .compartir--claro :focus-visible { outline-color: #fff; }
  .compartir__menu :focus-visible { outline-color: var(--acento); }
  @media (prefers-reduced-motion: no-preference) {
    .compartir__menu:not([hidden]) { animation: compartir-abre var(--dur-ui) var(--ease-out); }
  }
  @keyframes compartir-abre { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-compartir]').forEach((caja) => {
    const btn = caja.querySelector<HTMLButtonElement>('.compartir__btn')!;
    const menu = caja.querySelector<HTMLElement>('.compartir__menu')!;
    const estado = caja.querySelector<HTMLElement>('[data-estado]')!;
    const { titulo = '', texto = '', url = location.href } = caja.dataset;
    let t = 0;

    const avisar = (msg: string) => {
      clearTimeout(t);
      estado.textContent = msg;
      t = window.setTimeout(() => { estado.textContent = ''; }, 2000);
    };
    const abrir = (si: boolean) => {
      menu.hidden = !si;
      btn.setAttribute('aria-expanded', String(si));
      if (si) menu.querySelector<HTMLElement>('a, button')?.focus();
    };

    btn.addEventListener('click', async () => {
      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title: titulo, text: texto, url });
          return;
        } catch (e) {
          if ((e as DOMException)?.name === 'AbortError') return;
        }
      }
      abrir(menu.hidden);
    });

    caja.querySelector('[data-copiar]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        avisar('Enlace copiado');
      } catch {
        avisar('No se pudo copiar el enlace');
      }
      abrir(false);
      btn.focus();
    });

    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => abrir(false)));
    caja.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { abrir(false); btn.focus(); }
    });
    caja.addEventListener('focusout', (e) => {
      if (!menu.hidden && !caja.contains(e.relatedTarget as Node | null)) abrir(false);
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !caja.contains(e.target as Node)) abrir(false);
    });
  });
</script>
