---
// Rejilla de ponentes confirmados (src/data/ponentes.json) + aviso discreto "Más ponentes por anunciar".
import PonenteTarjeta from './PonenteTarjeta.astro';
import datos from '../data/ponentes.json';
import { withBase } from '../utils/paths';
const malla = `--malla:url(${withBase('/img/patron-malla-claro.svg')})`;
---
<ul class="ponentes-grid" role="list" style={malla}>
  {datos.ponentes.map((p, i) => (
    <li data-reveal data-reveal-delay={i * 80}><PonenteTarjeta ponente={p} /></li>
  ))}
</ul>
{datos.masPorAnunciar && (
  <p class="ponentes-mas" data-reveal><span class="ponentes-mas__marca" aria-hidden="true"></span>{datos.masPorAnunciar}</p>
)}
<style>
  .ponentes-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1rem, 2vw, 1.5rem); grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr)); }
  .ponentes-grid > li { min-width: 0; }
  .ponentes-mas { display: flex; align-items: center; gap: .6rem; margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0; font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--texto-2); max-width: none; }
  .ponentes-mas__marca { flex: none; width: 1.25rem; height: 2px; background: var(--cobre); }
</style>
