---
// Icono de Instagram en SVG propio, solo contorno (decorativo: el texto o aria-label lo da el enlace que lo contiene).
interface Props { size?: number; }
const { size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.3" cy="6.7" r=".6" fill="currentColor" stroke="none" /></svg>
