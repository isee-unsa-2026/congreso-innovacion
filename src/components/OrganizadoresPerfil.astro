---
// Comité organizador como credenciales del congreso (fotocheck colgando de una cinta granate):
// franja superior con la marca, foto, nombre, cargo y franja "Organizador". Compactas: son varios.
// Al aparecer, la credencial cae con un balanceo leve. Sin dorado.
import { withBase } from '../utils/paths';
import { enPublic, iniciales } from '../utils/medios';
import site from '../data/site.json';
import datos from '../data/organizadores.json';

const lista = datos.organizadores.map((o: any) => ({
  ...o,
  nombreCompleto: [o.titulo, o.nombre].filter(Boolean).join(' '),
  hayFoto: enPublic(o.foto),
}));
---
<ul class="creds" role="list">
  {lista.map((o, i) => (
    <li class="cred-item" data-reveal data-reveal-delay={(i % 5) * 90}>
      <span class="cinta" aria-hidden="true"><span class="cinta__clip"></span></span>
      <article class="cred">
        <header class="cred__cab">
          <span class="cred__marca">{site.kicker}</span>
        </header>
        <div class="cred__cuerpo">
          <figure class="cred__foto">
            {o.hayFoto
              ? <img src={withBase(o.foto)} width="640" height="800" alt={`Foto de ${o.nombreCompleto}`} loading="lazy" decoding="async" />
              : <span class="cred__mono" aria-hidden="true">{iniciales(o.nombre)}</span>}
          </figure>
          <h3 class="cred__nombre">{o.nombreCompleto}</h3>
          {o.cargo && <p class="cred__cargo">{o.cargo}</p>}
        </div>
        <footer class="cred__pie">
          <span>Organizador</span>
        </footer>
      </article>
    </li>
  ))}
</ul>

<style>
  .creds { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 1.25rem clamp(1rem, 2.5vw, 1.75rem); }
  .cred-item { position: relative; width: min(14rem, 100%); padding-top: 2.6rem; }

  /* Cinta y clip */
  .cinta { position: absolute; z-index: 2; top: 0; left: 50%; width: 18px; height: 2.9rem; translate: -50% 0; background: linear-gradient(90deg, var(--acento-oscuro), var(--acento) 30%, var(--acento) 70%, var(--acento-oscuro)); }
  .cinta::before { content: ""; position: absolute; inset: 0 5px; border-inline: 1px dashed rgba(255, 255, 255, .35); }
  .cinta__clip { position: absolute; left: 50%; bottom: -.55rem; width: 28px; height: 13px; translate: -50% 0; border-radius: 4px; background: linear-gradient(180deg, #d9dadc, #9ea1a6); box-shadow: 0 1px 2px rgba(0, 0, 0, .3); }

  /* Credencial */
  .cred { position: relative; overflow: hidden; background: #fff; border-radius: 14px; border: 1px solid var(--linea); box-shadow: 0 24px 40px -26px rgba(18, 19, 21, .5), 0 2px 6px rgba(18, 19, 21, .06); text-align: center; }
  .cred::before { content: ""; position: absolute; top: .45rem; left: 50%; z-index: 1; width: 36px; height: 7px; translate: -50% 0; border-radius: 4px; background: var(--fondo); box-shadow: inset 0 1px 2px rgba(0, 0, 0, .25); }
  .cred__cab { display: grid; padding: 1.25rem .75rem .6rem; background: var(--acento); color: #fff; }
  .cred__marca { font: 700 .625rem/1.2 var(--f-texto); letter-spacing: .16em; text-transform: uppercase; }
  .cred__cuerpo { padding: .9rem .9rem .85rem; }
  .cred__foto { width: 7.25rem; margin: 0 auto .75rem; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; border: 3px solid #fff; outline: 1px solid var(--linea); box-shadow: 0 8px 18px -12px rgba(18, 19, 21, .5); }
  .cred__foto img, .cred__mono { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; }
  .cred__mono { display: grid; place-items: center; color: #fff; font: 700 2rem/1 var(--f-display); background: linear-gradient(160deg, var(--tinta-2), var(--tinta)); }
  .cred__nombre { margin: 0; color: var(--texto); font: 700 1.125rem/1.2 var(--f-display); letter-spacing: -.01em; }
  .cred__cargo { margin: .35rem 0 0; font: 600 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--acento); }
  .cred__pie { display: flex; justify-content: center; align-items: center; padding: .45rem .75rem; background: var(--tinta); color: #fff; font: 700 .625rem/1 var(--f-texto); letter-spacing: .22em; text-transform: uppercase; }

  /* Entrada: cae desde arriba y se balancea hasta quedar quieta */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cred-item[data-reveal] { opacity: 1; filter: none; transform: none; }
    :global(.js) .cred-item[data-reveal] .cred, :global(.js) .cred-item[data-reveal] .cinta { opacity: 0; }
    :global(.js) .cred-item[data-reveal].is-in .cinta { opacity: 1; animation: cinta-baja .5s var(--ease-out) calc(var(--rd, 0) * 1ms) both; }
    :global(.js) .cred-item[data-reveal].is-in .cred { opacity: 1; transform-origin: 50% -2.5rem; animation: cred-cae 1.5s var(--ease-out) calc(var(--rd, 0) * 1ms + 150ms) both; }
    :global(.js) .cred-item[data-reveal].is-quieto .cinta, :global(.js) .cred-item[data-reveal].is-quieto .cred { animation: none; }
    @media (hover: hover) {
      .cred-item:hover .cred { animation: cred-mece 1.4s var(--ease-out); transform-origin: 50% -2.5rem; }
    }
  }
  @keyframes cinta-baja { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes cred-cae {
    0% { opacity: 0; transform: translateY(-2.5rem) rotate(-7deg); }
    35% { opacity: 1; transform: translateY(0) rotate(4deg); }
    60% { transform: rotate(-2deg); }
    80% { transform: rotate(.8deg); }
    100% { transform: none; }
  }
  @keyframes cred-mece { 0%, 100% { transform: none; } 30% { transform: rotate(2.5deg); } 60% { transform: rotate(-1.5deg); } 80% { transform: rotate(.5deg); } }
</style>
