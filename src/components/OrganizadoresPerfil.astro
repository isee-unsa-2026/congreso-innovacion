---
// Comité organizador en formato de perfil (distinto a las tarjetas de ponentes): foto vertical con un
// bloque granate desplazado detrás, nombre grande en tinta y datos en filas sobrias. Sin dorado.
import { withBase } from '../utils/paths';
import { enPublic, iniciales } from '../utils/medios';
import datos from '../data/organizadores.json';

const lista = datos.organizadores.map((o: any) => ({
  ...o,
  nombreCompleto: [o.titulo, o.nombre].filter(Boolean).join(' '),
  hayFoto: enPublic(o.foto),
  hayLogo: o.logo && enPublic(o.logo.src),
}));
---
<ol class="orgs" role="list">
  {lista.map((o, i) => (
    <li class="org" data-reveal>
      <figure class="org__foto">
        {o.hayFoto
          ? <img src={withBase(o.foto)} width="640" height="800" alt={`Foto de ${o.nombreCompleto}`} loading="lazy" decoding="async" />
          : <span class="org__mono" aria-hidden="true">{iniciales(o.nombre)}</span>}
      </figure>
      <div class="org__texto">
        <p class="org__n">{String(i + 1).padStart(2, '0')}</p>
        <h3 class="org__nombre">{o.nombreCompleto}</h3>
        <p class="org__cargo">{o.cargo}</p>
        {o.frase && <p class="org__frase">{o.frase}</p>}
        <dl class="org__datos">
          <div>
            <dt>Organización</dt>
            <dd>
              {o.hayLogo && <img class="org__logo" src={withBase(o.logo.src)} alt="" width={o.logo.ancho} height={o.logo.alto} loading="lazy" decoding="async" />}
              {o.organizacion}
            </dd>
          </div>
          <div>
            <dt>Evento</dt>
            <dd>{datos.evento}</dd>
          </div>
        </dl>
      </div>
    </li>
  ))}
</ol>

<style>
  .orgs { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .org { display: grid; grid-template-columns: minmax(13rem, 20rem) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: end; }

  /* Foto vertical con bloque granate desplazado detrás */
  .org__foto { position: relative; isolation: isolate; margin: 0 0 1.25rem 1.25rem; aspect-ratio: 4 / 5; }
  .org__foto::before { content: ""; position: absolute; z-index: -1; left: -1.25rem; bottom: -1.25rem; width: 72%; height: 64%; background: var(--acento); border-radius: var(--radio); }
  .org__foto img, .org__mono { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; border-radius: var(--radio); box-shadow: 0 20px 40px -24px rgba(18, 19, 21, .45); }
  .org__mono { display: grid; place-items: center; color: #fff; font: 700 3.5rem/1 var(--f-display); letter-spacing: .06em; background: linear-gradient(160deg, var(--tinta-2), var(--tinta)); }

  .org__texto { padding-bottom: 1.25rem; }
  .org__n { margin: 0 0 .75rem; font: 700 clamp(2.75rem, 2rem + 3vw, 4.5rem)/.9 var(--f-display); color: transparent; -webkit-text-stroke: 1px var(--linea-2, #c9c4bd); }
  .org__nombre { margin: 0; color: var(--texto); font: 700 clamp(2rem, 1.4rem + 2.4vw, 3.25rem)/1.05 var(--f-display); letter-spacing: -.015em; }
  .org__cargo { margin: .6rem 0 0; font: 600 var(--t-sm)/1.3 var(--f-texto); letter-spacing: .12em; text-transform: uppercase; color: var(--acento); }
  .org__frase { margin: 1rem 0 0; max-width: 48ch; color: var(--texto-2); font-size: 1.0625rem; line-height: 1.55; }
  .org__datos { margin: 1.75rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 36rem; border-top: 2px solid var(--texto); }
  .org__datos div { padding: .75rem 1rem .8rem 0; border-bottom: 1px solid var(--linea); }
  .org__datos dt { font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--texto-2); }
  .org__datos dd { display: flex; align-items: center; gap: .55rem; margin: .35rem 0 0; font-size: var(--t-sm); font-weight: 600; color: var(--texto); }
  .org__logo { flex: none; width: 30px; height: 30px; object-fit: contain; }

  /* Entrada: el bloque granate crece, la foto se descubre de abajo hacia arriba y luego llega el texto */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .org[data-reveal] { transform: none; filter: none; }
    :global(.js) .org[data-reveal] .org__foto::before { transform: scale(.4); transform-origin: left bottom; opacity: 0; transition: transform 1s var(--ease-out), opacity .6s var(--ease-out); }
    :global(.js) .org[data-reveal] .org__foto img, :global(.js) .org[data-reveal] .org__mono { clip-path: inset(100% 0 0 0); transition: clip-path 1.1s var(--ease-out) .2s; }
    :global(.js) .org[data-reveal] .org__texto > * { opacity: 0; transform: translateY(12px); transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
    :global(.js) .org[data-reveal] .org__texto > :nth-child(2) { transition-delay: .45s; }
    :global(.js) .org[data-reveal] .org__texto > :nth-child(3) { transition-delay: .55s; }
    :global(.js) .org[data-reveal] .org__texto > :nth-child(n+4) { transition-delay: .65s; }
    :global(.js) .org[data-reveal] .org__texto > :first-child { transition-delay: .35s; }
    :global(.js) .org[data-reveal].is-in .org__foto::before { transform: none; opacity: 1; }
    :global(.js) .org[data-reveal].is-in .org__foto img, :global(.js) .org[data-reveal].is-in .org__mono { clip-path: inset(0 0 0 0); }
    :global(.js) .org[data-reveal].is-in .org__texto > * { opacity: 1; transform: none; }
    :global(.js) .org[data-reveal].is-quieto .org__foto::before,
    :global(.js) .org[data-reveal].is-quieto .org__foto img,
    :global(.js) .org[data-reveal].is-quieto .org__mono,
    :global(.js) .org[data-reveal].is-quieto .org__texto > * { transition: none; }
  }

  @media (max-width: 44rem) {
    .org { grid-template-columns: 1fr; align-items: start; }
    .org__foto { max-width: 17rem; }
    .org__datos { grid-template-columns: 1fr; }
  }
</style>
