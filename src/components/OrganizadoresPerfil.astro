---
// Comité organizador como credenciales del congreso (fotocheck):
// franja superior con la marca, foto, nombre, cargo y franja "Organizador". Compactas: son varios.
// Al aparecer, la credencial cae con un balanceo leve. Sin dorado.
import { withBase } from '../utils/paths';
import { enPublic, iniciales } from '../utils/medios';
import site from '../data/site.json';
import datos from '../data/organizadores.json';

const lista = datos.organizadores.map((o: any) => ({
  ...o,
  nombreCompleto: [o.titulo, o.nombre].filter(Boolean).join(' '),
  hayFoto: enPublic(o.foto),
}));
// Primera fila: asesora y presidencia; debajo, el resto del equipo directivo
const filas = [
  { clase: 'creds creds--lideres', items: lista.filter((o) => o.destacado) },
  { clase: 'creds', items: lista.filter((o) => !o.destacado) },
].filter((f) => f.items.length);
---
{filas.map((fila) => (
<ul class={fila.clase} role="list">
  {fila.items.map((o, i) => (
    <li class="cred-item" data-reveal data-reveal-delay={(i % 5) * 90}>
      <article class="cred">
        <header class="cred__cab">
          <span class="cred__marca">{site.kicker}</span>
        </header>
        <div class="cred__cuerpo">
          <figure class="cred__foto">
            {o.hayFoto
              ? <img src={withBase(o.foto)} width="400" height="400" alt={o.nombreCompleto ? `Foto de ${o.nombreCompleto}` : "Foto de un integrante del comité organizador"} loading="lazy" decoding="async" />
              : <span class="cred__mono" aria-hidden="true">{iniciales(o.nombre)}</span>}
          </figure>
          {o.nombreCompleto && <h3 class="cred__nombre">{o.nombreCompleto}</h3>}
          {o.cargo && <p class="cred__cargo">{o.cargo}</p>}
        </div>
        <footer class="cred__pie">
          <span>{o.rol || 'Organizador'}</span>
        </footer>
      </article>
    </li>
  ))}
</ul>
))}

<style>
  .creds { overflow-x: clip; overflow-clip-margin: 1rem; /* el balanceo de entrada no desborda en celular */ list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 1.25rem clamp(1rem, 2.5vw, 1.75rem); }
  .cred-item { position: relative; display: flex; width: min(14rem, 100%); }
  .cred-item > .cred { flex: 1; display: flex; flex-direction: column; } /* misma altura en cada fila */
  .cred-item .cred__cuerpo { flex: 1; }
  .creds + .creds { margin-top: clamp(1.5rem, 3vw, 2.25rem); }


  /* Credencial */
  .cred { position: relative; overflow: hidden; background: #fff; border-radius: 14px; border: 1px solid var(--linea); box-shadow: 0 24px 40px -26px rgba(18, 19, 21, .5), 0 2px 6px rgba(18, 19, 21, .06); text-align: center; }
  .cred::before { content: ""; position: absolute; top: .45rem; left: 50%; z-index: 1; width: 36px; height: 7px; translate: -50% 0; border-radius: 4px; background: var(--fondo); box-shadow: inset 0 1px 2px rgba(0, 0, 0, .25); }
  .cred__cab { display: grid; padding: 1.25rem .75rem 3.1rem; background: var(--acento); color: #fff; }
  .cred__marca { font: 700 .5625rem/1.2 var(--f-texto); letter-spacing: .1em; white-space: nowrap; text-transform: uppercase; }
  .cred__cuerpo { min-height: 11.75rem; padding: 0 .9rem .85rem; } /* misma altura con o sin nombre */
  .cred__foto { position: relative; z-index: 1; width: 8.75rem; margin: -2.6rem auto .8rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 4px solid #fff; outline: 2px solid var(--acento); outline-offset: 2px; box-shadow: 0 12px 24px -14px rgba(18, 19, 21, .6); }
  .cred__foto img, .cred__mono { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .cred__mono { display: grid; place-items: center; color: #fff; font: 700 2rem/1 var(--f-display); background: linear-gradient(160deg, var(--tinta-2), var(--tinta)); }
  .cred__nombre { margin: 0; color: #3b4047; font: 500 .875rem/1.35 var(--f-texto); letter-spacing: .01em; }
  .cred__cargo { margin: .35rem 0 0; font: 600 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--acento); }
  .cred__pie { display: flex; justify-content: center; align-items: center; padding: .45rem .75rem; background: var(--tinta); color: #fff; font: 700 .5625rem/1 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }

  /* Entrada: cae desde arriba y se balancea hasta quedar quieta */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cred-item[data-reveal] { opacity: 1; filter: none; transform: none; }
    :global(.js) .cred-item[data-reveal] .cred { opacity: 0; }
    :global(.js) .cred-item[data-reveal].is-in .cred { opacity: 1; transform-origin: 50% 0; animation: cred-cae 1.5s var(--ease-out) calc(var(--rd, 0) * 1ms + 150ms) both; }
    :global(.js) .cred-item[data-reveal].is-quieto .cred { animation: none; }
    @media (hover: hover) {
      .cred-item:hover .cred { animation: cred-mece 1.4s var(--ease-out); transform-origin: 50% 0; }
    }
  }
  @keyframes cred-cae {
    0% { opacity: 0; transform: translateY(-2.5rem) rotate(-7deg); }
    35% { opacity: 1; transform: translateY(0) rotate(4deg); }
    60% { transform: rotate(-2deg); }
    80% { transform: rotate(.8deg); }
    100% { transform: none; }
  }
  @keyframes cred-mece { 0%, 100% { transform: none; } 30% { transform: rotate(2.5deg); } 60% { transform: rotate(-1.5deg); } 80% { transform: rotate(.5deg); } }
  /* Celular: dos por fila, más compactas */
  @media (max-width: 34rem) {
    .creds { gap: .9rem .75rem; }
    .cred-item { width: calc(50% - .375rem); }
    .cred__cab { padding: 1.1rem .5rem 2.4rem; }
    .cred__marca { font-size: .5rem; letter-spacing: .1em; }
    .cred__foto { width: 6.5rem; margin-top: -2rem; border-width: 3px; }
    .cred__cuerpo { min-height: 9rem; padding: 0 .5rem .7rem; }
    .cred__nombre { font-size: .8125rem; }
    .cred__pie { font-size: .5625rem; letter-spacing: .12em; }
  }
</style>
