---
// "Lo que encontrarás": tres rasgos del congreso en una rejilla de reglas finas, sin cajas.
// Las empresas se muestran con sus logos (LogosEmpresas); si falta un logo, queda el nombre en texto.
import site from '../data/site.json';
import { withBase } from '../utils/paths';
import LogosEmpresas from './LogosEmpresas.astro';
const rasgos = [
  {
    titulo: 'Ponencias de la industria',
    html: 'Referentes de empresas mineras líderes y de la academia compartirán su experiencia en la operación y la innovación minera.',
    logos: true,
  },
  {
    titulo: `Concurso ${site.retoName}`,
    html: `Equipos multidisciplinarios de la UNSA proponen soluciones a retos planteados por ENAEX, empresa patrocinadora del congreso, o por los propios equipos, con foco en la perforación y voladura. <a href="${withBase('/reto/')}">Conoce el concurso</a>.`,
  },
  {
    titulo: 'Networking',
    html: 'Un espacio para conocer y conversar con estudiantes, docentes y profesionales del sector minero.',
  },
];
---
<ul class="rasgos" role="list">
  {rasgos.map((p, i) => (
    <li class="punto" data-reveal data-reveal-delay={i * 70}>
      <span class="punto__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3>{p.titulo}</h3>
      <p set:html={p.html} />
      {p.logos && (
        <div class="punto__logos">
          <p class="punto__t">Con profesionales de</p>
          <LogosEmpresas area={2700} etiqueta="Empresas participantes" />
        </div>
      )}
    </li>
  ))}
</ul>
<style>
  .rasgos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; border-top: 2px solid var(--texto); }
  .punto { padding: 1.25rem 0 1.35rem; border-bottom: 1px solid var(--linea); }
  .punto__n { display: block; margin-bottom: .5rem; font: 700 1rem/1 var(--f-display); color: var(--acento); letter-spacing: .04em; }
  .punto h3 { font-size: 1.125rem; font-weight: 700; line-height: 1.2; margin-bottom: .35rem; }
  .punto p { margin: 0; font-size: var(--t-sm); color: var(--texto-2); }
  .punto__logos { margin-top: 1rem; padding-top: .9rem; border-top: 1px dashed var(--linea); }
  .punto .punto__t { margin: 0 0 .65rem; font: 500 .6875rem/1.2 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: var(--texto-2); }
  @media (min-width: 52rem) {
    .rasgos { grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--linea); }
    .punto { padding: 1.35rem 1.5rem 1.5rem 0; border-bottom: 0; }
    .punto + .punto { padding-left: 1.5rem; border-left: 1px solid var(--linea); }
  }
</style>
