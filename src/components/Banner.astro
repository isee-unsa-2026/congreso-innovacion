---
// Banner de paginas internas: foto con velo oscuro, retícula sutil, etiqueta recta + titulo condensado.
// La imagen esta sobre el pliegue: se carga sin lazy. Una sola imagen (clave "banner" en imagenes.json).
import imagenes from '../data/imagenes.json';
// Si se pasa contenido (slot por defecto), reemplaza a titulo/acento dentro del h1 (p. ej. el wordmark INNOMINING).
interface Props { titulo?: string; acento?: string; etiqueta?: string; bajada?: string; imagen?: keyof typeof imagenes; id?: string; }
const { titulo = '', acento, etiqueta, bajada, imagen = 'banner', id = 'titulo-pagina' } = Astro.props;
const img = imagenes[imagen];
---
<div class="banner">
  <img class="banner__foto" src={img.src} alt={img.alt} width={img.width} height={img.height} decoding="async" />
  <div class="banner__velo" aria-hidden="true"></div>
  <div class="wrap banner__in">
    {etiqueta && <p class="etiqueta etiqueta--clara anim" style="--d:0ms">{etiqueta}</p>}
    <h1 id={id} class="anim" style="--d:90ms">{Astro.slots.has('default') ? <slot /> : <>{titulo}{titulo && acento ? ' ' : ''}{acento && <em>{acento}</em>}</>}</h1>
    {bajada && <p class="banner__bajada anim" style="--d:170ms">{bajada}</p>}
  </div>
</div>
<style>
  .banner { position: relative; isolation: isolate; display: grid; align-items: end; min-height: clamp(10rem, 16vw, 13rem); background: var(--tinta); overflow: hidden; }
  .banner__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; z-index: -2; }
  .banner__velo {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(0deg, rgba(14, 15, 16, .6), transparent 60%),
      linear-gradient(90deg, rgba(14, 15, 16, .92) 0%, rgba(14, 15, 16, .72) 55%, rgba(14, 15, 16, .5) 100%);
  }
  .banner__in { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: start; gap: .25rem; padding-block: 2rem 1.75rem; }
  .banner .etiqueta { margin-bottom: .75rem; }
  .banner h1 { margin: 0; color: #fff; font-size: clamp(1.875rem, 1.4rem + 2vw, 2.625rem); font-weight: 700; line-height: 1.1; }
  .banner h1 em { font-style: italic; color: var(--cobre-2); }
  .banner__bajada { margin: .6rem 0 0; color: rgba(255, 255, 255, .88); font-size: 1.0625rem; max-width: 52ch; }
</style>
