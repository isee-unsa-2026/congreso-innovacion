---
import fs from 'node:fs';
import path from 'node:path';
import site from '../data/site.json';
const hayUnsa = fs.existsSync(path.join(process.cwd(), 'public', 'brand', 'unsa-logo.png'));
---
<footer class="pie">
  <div class="wrap pie__top">
    <p class="pie__marca" aria-hidden="true">{site.brand} <span>{site.year}</span></p>
    <div class="pie__logos">
      <img src="/brand/isee-unsa-logo-512.png" width="64" height="64" alt={site.organizerFull} loading="lazy" decoding="async" />
      {hayUnsa && (
        <>
          <span class="pie__sep" aria-hidden="true"></span>
          <img class="pie__unsa" src="/brand/unsa-logo.png" width="206" height="256" alt={site.host} loading="lazy" decoding="async" />
        </>
      )}
    </div>
  </div>
  <div class="wrap pie__in">
    <div>
      <p class="pie__t">El evento</p>
      <p>{site.name}<br /><span class="pie__suave">{site.kicker}</span><br />{site.dates}<br />{site.city}</p>
    </div>
    <nav aria-label="Pie de página">
      <p class="pie__t">Navegación</p>
      <ul>
        {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="pie__t">Organiza</p>
      <p>{site.organizerFull}<br /><span class="pie__suave">Sede anfitriona: {site.host}</span></p>
    </div>
    <div>
      <p class="pie__t">Contacto</p>
      <p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    </div>
  </div>
  <div class="wrap pie__fin">
    <span>© 2026 {site.organizerFull}. Ingreso gratuito.</span>
    <span><a href="/privacidad/">Privacidad</a> · <a href="/organizacion/">Organización</a></span>
  </div>
</footer>
<style>
  .pie { background: var(--pie); color: #c4c8cd; padding-block: clamp(2rem, 4vw, 2.75rem) 5rem; /* espacio para el botón flotante de WhatsApp */ font-size: var(--t-sm); }
  .pie p { margin: 0; max-width: none; }
  .pie a { color: #e8eaed; text-underline-offset: .2em; }
  .pie a:hover { color: var(--blanco); }
  .pie :focus-visible { outline-color: var(--blanco); }
  .pie__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-bottom: 1.25rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255, 255, 255, .14); }
  .pie__marca { font: 700 clamp(1.375rem, 1.1rem + 1vw, 1.75rem)/1.1 var(--f-display); letter-spacing: .02em; color: #fff; }
  .pie__marca span { color: var(--cobre); }
  .pie__logos { display: flex; align-items: center; gap: 1rem; }
  .pie__logos img { width: 64px; height: 64px; object-fit: contain; background: var(--blanco); border-radius: var(--radio); padding: 4px; }
  .pie__logos .pie__unsa { width: auto; height: 64px; background: transparent; padding: 0; }
  .pie__sep { width: 1px; height: 48px; background: rgba(255, 255, 255, .3); }
  .pie__in { display: grid; gap: 1.25rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); }
  .pie .pie__t { font: 500 var(--t-xs)/1.3 var(--f-texto); letter-spacing: .16em; text-transform: uppercase; color: var(--cobre); margin-bottom: .6rem; }
  .pie__suave { color: #a9afb6; }
  .pie ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, max-content); column-gap: 2rem; }
  .pie li a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .pie li a:hover { text-decoration: underline; }
  .pie__fin { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 1.5rem; margin-top: 1.25rem; padding-top: .75rem; border-top: 1px solid rgba(255, 255, 255, .14); font-size: var(--t-xs); color: #aeb4bb; }
  .pie__fin a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 22rem) { .pie ul { grid-template-columns: 1fr; } }
</style>
