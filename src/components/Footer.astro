---
import fs from 'node:fs';
import path from 'node:path';
import site from '../data/site.json';
import { withBase } from '../utils/paths';
const hayUnsa = fs.existsSync(path.join(process.cwd(), 'public', 'brand', 'unsa-logo.png'));
---
<footer class="pie">
  <div class="wrap pie__top">
    <div class="pie__id">
      <div class="pie__logos">
        <img src={withBase('/brand/isee-unsa-logo-512.png')} width="44" height="44" alt={site.organizerFull} loading="lazy" decoding="async" />
        {hayUnsa && <img class="pie__unsa" src={withBase('/brand/unsa-logo.png')} width="35" height="44" alt={site.host} loading="lazy" decoding="async" />}
      </div>
      <p class="pie__marca">{site.name}<span>{site.kicker} · {site.dates}</span></p>
    </div>
  </div>
  <div class="wrap pie__in">
    <div>
      <p class="pie__t">Lugar</p>
      <p>{site.place}<br />{site.city}</p>
    </div>
    <nav aria-label="Pie de página">
      <p class="pie__t">Navegación</p>
      <ul>
        {site.nav.map((n) => <li><a href={withBase(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="pie__t">Organiza</p>
      <p>{site.organizerFull}<br />Sede: {site.host}</p>
    </div>
    <div>
      <p class="pie__t">Contacto</p>
      <p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
      {site.instagram && <p class="pie__ig"><a href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramUser}<span class="sr"> (se abre en una pestaña nueva)</span></a></p>}
    </div>
  </div>
  <div class="wrap pie__fin">
    <span>© 2026 {site.organizerFull}. Ingreso gratuito.</span>
    <span><a href={withBase('/privacidad/')}>Privacidad</a></span>
  </div>
</footer>
<style>
  /* Pie sobrio: letra pequeña y grises suaves; los enlaces se aclaran al pasar el cursor */
  .pie { background: var(--pie); color: #9aa0a7; padding-block: 1.75rem 6rem; /* espacio para los botones flotantes (WhatsApp + Instagram) */ font-size: .8125rem; line-height: 1.6; }
  .pie p { margin: 0; max-width: none; }
  .pie a { color: #d3d6da; text-decoration: none; }
  .pie a:hover { color: var(--blanco); text-decoration: underline; text-underline-offset: .2em; }
  .pie :focus-visible { outline-color: var(--blanco); }
  .pie__top { padding-bottom: 1.1rem; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(255, 255, 255, .1); }
  .pie__id { display: flex; align-items: center; gap: 1rem; }
  .pie__logos { display: flex; align-items: center; gap: .6rem; }
  .pie__logos img { width: 44px; height: 44px; object-fit: contain; background: var(--blanco); border-radius: 50%; padding: 3px; }
  .pie__logos .pie__unsa { width: auto; height: 44px; background: transparent; padding: 0; border-radius: 0; }
  .pie__marca { display: grid; gap: .1rem; font: 600 .9375rem/1.3 var(--f-display); color: #eef0f2; }
  .pie__marca span { font: 400 .75rem/1.3 var(--f-texto); color: #8a9098; }
  .pie__in { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr)); }
  .pie .pie__t { font: 600 .6875rem/1.3 var(--f-texto); letter-spacing: .14em; text-transform: uppercase; color: #6f767e; margin-bottom: .45rem; }
  .pie .pie__ig { margin-top: .2rem; }
  .pie ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, max-content); column-gap: 1.5rem; }
  .pie li a { display: inline-flex; align-items: center; min-height: 28px; }
  .pie__fin { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 1.5rem; margin-top: 1.25rem; padding-top: .6rem; border-top: 1px solid rgba(255, 255, 255, .1); font-size: .75rem; color: #737a82; }
  .pie__fin a { display: inline-flex; align-items: center; min-height: 28px; color: #9aa0a7; }
  @media (max-width: 22rem) { .pie ul { grid-template-columns: 1fr; } }
</style>
